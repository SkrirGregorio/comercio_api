# Copia este archivo como .env y ajusta los valores.

# Base de datos (docker-compose expone Postgres en el puerto 5434)
DB_HOST=localhost
DB_PORT=5434
DB_USER=admin
DB_PASS=cambia_esta_contraseña
DB_NAME=comercio_db
# Crea/actualiza tablas automáticamente. En producción: false (usar migraciones).
DB_SYNC=true

# Obligatorio: la API no arranca sin él. Genera uno con: openssl rand -base64 48
JWT_SECRET=

# URL pública de la API (se usa para construir las URLs de las imágenes subidas)
BASE_URL=http://localhost:3000

# Orígenes permitidos para CORS, separados por comas (dominio de la PWA)
CORS_ORIGINS=http://localhost:4200

# Contraseña de las cuentas de prueba creadas por `npm run seed`
# (si se omite se usa la definida en src/seed/seed-data.ts)
SEED_PASSWORD=

# --- Producción (Cloud Run). En local se dejan vacías. ---
# Bucket de Cloud Storage para las imágenes subidas. Vacío = disco local (public/uploads)
GCS_BUCKET=
# URL pública base de las imágenes (por defecto https://storage.googleapis.com/<GCS_BUCKET>)
GCS_PUBLIC_URL=
# Saltos de proxy de confianza para obtener la IP real: 1 = local/Cloud Run, 2 = balanceador + Cloud Run
TRUST_PROXY_HOPS=1
