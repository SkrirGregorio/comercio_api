# Configuración del despliegue en Google Cloud (sin secretos: esos van a Secret Manager).
# Cualquier valor se puede sobrescribir con una variable de entorno al ejecutar los scripts,
# p. ej.:  DOMAIN=comerciolocal.com ./deploy/03-load-balancer.sh

# Proyecto de GCP. Por defecto, el configurado en gcloud (gcloud config set project <ID>)
PROJECT_ID="${PROJECT_ID:-$(gcloud config get-value project 2>/dev/null)}"

# Región: la indicada en la Política de Privacidad (us-central1, Iowa)
REGION="${REGION:-us-central1}"

# Dominio público. Vacío = <IP-del-balanceador>.sslip.io (temporal, sin comprar dominio)
DOMAIN="${DOMAIN:-}"

# Cloud SQL (PostgreSQL)
SQL_INSTANCE="${SQL_INSTANCE:-comercio-db}"
SQL_TIER="${SQL_TIER:-db-f1-micro}"
DB_NAME="${DB_NAME:-comercio_db}"
DB_OWNER_USER="${DB_OWNER_USER:-comercio_owner}" # dueño del esquema: migraciones
DB_APP_USER="${DB_APP_USER:-comercio_app}"       # usado por la API: solo DML

# Cloud Run y Artifact Registry
API_SERVICE="${API_SERVICE:-comercio-api}"
AR_REPO="${AR_REPO:-comercio}"
SERVICE_ACCOUNT_NAME="${SERVICE_ACCOUNT_NAME:-comercio-api}"

# Cloud Storage (los nombres de bucket son globales: se prefijan con el proyecto)
WEB_BUCKET="${WEB_BUCKET:-${PROJECT_ID}-web}"
UPLOADS_BUCKET="${UPLOADS_BUCKET:-${PROJECT_ID}-uploads}"

# Balanceador HTTPS
LB_IP_NAME="${LB_IP_NAME:-comercio-ip}"
URL_MAP="${URL_MAP:-comercio-lb}"

# Secret Manager
SECRET_JWT="${SECRET_JWT:-comercio-jwt-secret}"
SECRET_DB_OWNER="${SECRET_DB_OWNER:-comercio-db-owner-pass}"
SECRET_DB_APP="${SECRET_DB_APP:-comercio-db-app-pass}"
SECRET_SEED="${SECRET_SEED:-comercio-seed-pass}"
